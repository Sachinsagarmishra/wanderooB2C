RewriteEngine On

# Clean URLs for Destination Page
RewriteRule ^destination/([^/]+)/?$ destination.php?name=$1 [QSA,L]

# Clean URLs for Package Detail Page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !/admin/
RewriteRule ^([^/]+)/([^/]+)/?$ package-detail.php?destination=$1&tour=$2 [QSA,L]

# Redirect /filename.php to /filename (External Redirect)
RewriteCond %{REQUEST_METHOD} !POST [NC]
RewriteCond %{REQUEST_URI} !/admin/ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Check if the requested name with .php extension exists as a file
# and internally rewrite /filename to /filename.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L]
